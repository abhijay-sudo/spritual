# Optional. Empty/unset selects the explicitly labelled local demo.
# Set to real to use the separate authenticated Supabase development path.
# With no valid URL/browser key it shows a connection-required screen; it never
# substitutes demo identities or content. No live project is supplied here.
VITE_ALPHA_MODE=
VITE_SUPABASE_URL=
# Browser publishable key (or legacy anon key) only. NEVER a secret/service-role key.
VITE_SUPABASE_PUBLISHABLE_KEY=
