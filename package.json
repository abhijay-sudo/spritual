{
  "name": "spiritual",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "build": "npm run content:audit && npm run build -w web",
    "content:audit": "node scripts/audit-bundled-content.mjs",
    "content:release-preflight": "node scripts/audit-bundled-content.mjs --release",
    "typecheck": "tsc -p web/tsconfig.json --noEmit --pretty false",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "preview": "npm run preview -w web -- --host 127.0.0.1 --port 4173 --strictPort",
    "mobile:sync": "npm run content:audit && npm run build:native -w web && npm exec -w web -- cap sync && node scripts/verify-native-bundle.mjs",
    "mobile:android": "npm exec -w web -- cap open android",
    "mobile:ios": "npm exec -w web -- cap open ios",
    "mobile:doctor": "node scripts/mobile-doctor.mjs",
    "mobile:apk": "node scripts/build-android.mjs",
    "mobile:assets": "node scripts/generate-native-assets.mjs",
    "mobile:verify": "node scripts/verify-native-bundle.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@playwright/test": "^1.63.0",
    "sharp": "0.35.4"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
